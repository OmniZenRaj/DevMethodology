#!/usr/bin/env python3
"""Keep the Claude Code VS Code terminal open after /exit.

The extension disposes its terminal when `claude` exits. This removes that
dispose call from the newest installed anthropic.claude-code extension (or
from the extension.js passed as an argument). Safe to re-run; reload the
VS Code window afterwards.
"""
import re
import sys
from pathlib import Path

PATTERN = re.compile(r"(Claude terminal closed after[^`]*`\)),(\w+)\.dispose\(\)")


def target() -> Path:
    if len(sys.argv) > 1:
        return Path(sys.argv[1])
    dirs = sorted(
        Path.home().glob(".vscode/extensions/anthropic.claude-code-*"),
        key=lambda p: p.stat().st_mtime,
    )
    if not dirs:
        sys.exit("No anthropic.claude-code extension found")
    return dirs[-1] / "extension.js"


def main() -> None:
    path = target()
    src = path.read_text()
    patched, n = PATTERN.subn(r"\1,void 0", src)
    if n == 0:
        if "Claude terminal closed after" in src and ".dispose()" not in src.split(
            "Claude terminal closed after", 1
        )[1][:200]:
            print(f"Already patched: {path}")
            return
        sys.exit(f"Close-on-exit code not found; extension changed? {path}")
    path.write_text(patched)
    print(f"Patched {n} site(s): {path}")


if __name__ == "__main__":
    main()
