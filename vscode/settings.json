{
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 13,
  "debug.console.fontSize": 18,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.find.loop": false,
  "editor.accessibilitySupport": "off",
  "editor.inlayHints.enabled": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": { "other": "off" },
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "default",
  "window.density.editorTabHeight": "compact",
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#444444",
    "tab.activeBorderTop": "#FFFF00"
  },
  "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
  "window.commandCenter": false,
  "chat.commandCenter.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "outline.showConstants": false,
  "outline.showBooleans": false,
  "outline.showArrays": false,
  "outline.showEnumMembers": false,
  "outline.showEnums": false,
  "outline.showFields": false,
  "outline.showFiles": false,
  "outline.showKeys": false,
  "diffEditor.codeLens": true,
  "debug.inlineValues": "on",
  "debug.openDebug": "neverOpen",

  "claudeCode.useTerminal": true,
  "claudeCode.attachOpenFile": false,
  "terminal.integrated.commandsToSkipShell": ["workbench.action.quickSwitchWindow"],
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.tabs.description": "",
  "terminal.integrated.profiles.osx": {
    "Claude Code": {
      "path": "__HOME__/Applications/Claude Code.command",
      "icon": "sparkle",
      "color": "terminal.ansiMagenta"
    }
  },

  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "workbench.browser.openLocalhostLinks": false,
  "workbench.externalUriOpeners": {
    "http://localhost:*": "default",
    "http://127.0.0.1:*": "default",
    "https://localhost:*": "default",
    "https://127.0.0.1:*": "default"
  },
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.statusBar.enabled": false,
  "gitlens.statusBar.pullRequests.enabled": false,

  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.formatOnType": true,
    "editor.wordBasedSuggestions": "off"
  },
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.addHoverSummaries": true,
  "python.analysis.autoFormatStrings": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.experiments.enabled": false,
  "python.createEnvironment.trigger": "off",
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off",
  "flake8.enabled": false,
  "pylint.enabled": false,
  "ruff.lint.enable": false,

  "markdownlint.config": { "MD013": false, "MD022": false, "MD032": false, "MD034": false, "MD060": false },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[github-actions-workflow]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}
